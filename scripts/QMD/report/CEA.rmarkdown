# Probabilistic Sensitivity Analysis

```{r probabilistic-sa, include=FALSE}
# 12 - Probabilistic Sensitivity Analysis
if (file.exists(here("scripts/R/analysis/12_PSA.R"))) {
  suppressMessages(suppressWarnings(source(here("scripts/R/analysis/12_PSA.R"))))
} else {
  cat("PSA script not found\n")
}

# Debug: Check what PSA objects exist
psa_objects <- ls()[grepl("psa|ceac", ls(), ignore.case = TRUE)]
```

```{r psa-scatterplot}
#| fig-cap: "Cost-effectiveness Scatterplot from Probabilistic Sensitivity Analysis"
#| fig-height: 8
#| fig-width: 10

# Enhanced PSA scatterplot with better error handling and fallbacks
psa_plot_created <- FALSE

# Method 1: Try using dampack PSA object
if (exists("psa_obj") && "psa" %in% class(psa_obj)) {
  tryCatch({
    psa_plot <- plot(psa_obj, 
                     frontier = TRUE, 
                     points = TRUE,
                     alpha = 0.4,
                     txtsize = 11,
                     currency = "€",
                     effect_units = "QALYs") +
      theme_minimal() +
      theme(
        legend.position = "bottom",
        legend.title = element_text(size = 11),
        legend.text = element_text(size = 10)
      )
    
    print(psa_plot)
    psa_plot_created <- TRUE
  }, error = function(e) {
    cat("Failed to create PSA plot from psa_obj:", e$message, "\n")
  })
}

# Method 2: Try using raw PSA results
if (!psa_plot_created && exists("psa_results")) {
  tryCatch({
    if (is.list(psa_results) && "cost" %in% names(psa_results) && "effect" %in% names(psa_results)) {
      cost_matrix <- psa_results$cost
      effect_matrix <- psa_results$effect
      
      # Ensure matrices have the same dimensions
      if (all(dim(cost_matrix) == dim(effect_matrix))) {
        # Convert to long format
        n_sims <- nrow(cost_matrix)
        strategy_names <- colnames(cost_matrix)
        
        psa_data <- data.frame()
        for (i in 1:ncol(cost_matrix)) {
          strategy_data <- data.frame(
            Cost = cost_matrix[, i],
            Effect = effect_matrix[, i],
            Strategy = strategy_names[i],
            Simulation = 1:n_sims
          )
          psa_data <- rbind(psa_data, strategy_data)
        }
        
        # Remove any NA values
        psa_data <- psa_data[complete.cases(psa_data), ]
        
        if (nrow(psa_data) > 0) {
          # Create the plot
          p <- ggplot(psa_data, aes(x = Effect, y = Cost, color = Strategy)) +
            geom_point(alpha = 0.4, size = 0.8) +
            scale_y_continuous(labels = scales::dollar_format()) +
            scale_color_viridis_d(name = "Strategy") +
            labs(
              x = "Effectiveness (QALYs)",
              y = "Total Cost (€)"
            ) +
            theme_minimal() +
            theme(
              legend.position = "bottom",
              legend.title = element_text(size = 11),
              legend.text = element_text(size = 10)
            ) +
            guides(color = guide_legend(override.aes = list(alpha = 1, size = 3)))
          
          print(p)
          psa_plot_created <- TRUE
        }
      }
    }
  }, error = function(e) {
    cat("Failed to create PSA plot from psa_results:", e$message, "\n")
  })
}

# Method 3: Check for alternative PSA data structures
if (!psa_plot_created) {
  # Look for any dataframe with Cost, Effect, and Strategy columns
  possible_psa_objects <- ls()[grepl("psa", ls(), ignore.case = TRUE)]
  
  for (obj_name in possible_psa_objects) {
    obj <- get(obj_name)
    if (is.data.frame(obj) && all(c("Cost", "Effect", "Strategy") %in% names(obj))) {
      tryCatch({
        p <- ggplot(obj, aes(x = Effect, y = Cost, color = Strategy)) +
          geom_point(alpha = 0.4, size = 0.8) +
          scale_y_continuous(labels = scales::dollar_format()) +
          scale_color_viridis_d(name = "Strategy") +
          labs(
            x = "Effectiveness (QALYs)",
            y = "Total Cost (€)"
          ) +
          theme_minimal() +
          theme(legend.position = "bottom")
        
        print(p)
        psa_plot_created <- TRUE
        break
      }, error = function(e) {
        cat("Failed to create PSA plot from", obj_name, ":", e$message, "\n")
      })
    }
  }
}

# If all methods fail, display informative message
if (!psa_plot_created) {
  ggplot() + 
    annotate("text", x = 0.5, y = 0.5, 
             label = "PSA data not available or failed to process.\nCheck that:\n• Script 08 (sampling) completed successfully\n• Script 12 (PSA) ran without errors\n• PSA results are properly formatted", 
             size = 12, hjust = 0.5) +
    annotate("text", x = 0.5, y = 0.2,
             label = paste("Available PSA objects:", paste(psa_objects, collapse = ", ")),
             size = 10, hjust = 0.5, color = "darkgray") +
    xlim(0, 1) + ylim(0, 1) +
    theme_void()
}
```

```{r ceac-curve}
#| fig-cap: "Cost-Effectiveness Acceptability Curve (CEAC)"
#| fig-height: 8
#| fig-width: 10

# Enhanced CEAC with better error handling and fallbacks
ceac_plot_created <- FALSE

# Method 1: Try using pre-computed CEAC object
if (exists("ceac_obj") && "ceac" %in% class(ceac_obj)) {
  tryCatch({
    ceac_plot <- plot(ceac_obj, 
                      frontier = TRUE, 
                      currency = "€",
                      txtsize = 11) +
      theme_minimal() +
      theme(
        legend.position = "bottom",
        legend.title = element_text(size = 11),
        legend.text = element_text(size = 10)
      )
    
    print(ceac_plot)
    ceac_plot_created <- TRUE
  }, error = function(e) {
    cat("Failed to create CEAC plot from ceac_obj:", e$message, "\n")
  })
}

# Method 2: Try generating CEAC from PSA object
if (!ceac_plot_created && exists("psa_obj") && "psa" %in% class(psa_obj)) {
  tryCatch({
    wtp_range <- seq(0, 100000, by = 1000)
    ceac_obj_new <- dampack::ceac(wtp = wtp_range, psa = psa_obj)
    
    ceac_plot <- plot(ceac_obj_new, 
                      frontier = TRUE, 
                      currency = "€",
                      txtsize = 11) +
      theme_minimal() +
      theme(
        legend.position = "bottom",
        legend.title = element_text(size = 11),
        legend.text = element_text(size = 10)
      )
    
    print(ceac_plot)
    ceac_plot_created <- TRUE
  }, error = function(e) {
    cat("Failed to generate CEAC from psa_obj:", e$message, "\n")
  })
}

# Method 3: Manual CEAC calculation from PSA results
if (!ceac_plot_created && exists("psa_results")) {
  tryCatch({
    if (is.list(psa_results) && "cost" %in% names(psa_results) && "effect" %in% names(psa_results)) {
      cost_matrix <- psa_results$cost
      effect_matrix <- psa_results$effect
      
      if (all(dim(cost_matrix) == dim(effect_matrix))) {
        # Define WTP thresholds
        wtp_thresholds <- seq(0, 100000, by = 2000)
        strategy_names <- colnames(cost_matrix)
        n_strategies <- ncol(cost_matrix)
        n_sims <- nrow(cost_matrix)
        
        # Calculate CEAC manually
        ceac_data <- data.frame()
        
        for (wtp in wtp_thresholds) {
          # Calculate Net Monetary Benefit for each simulation and strategy
          nmb_matrix <- effect_matrix * wtp - cost_matrix
          
          # Find optimal strategy for each simulation
          optimal_strategies <- apply(nmb_matrix, 1, which.max)
          
          # Calculate probability for each strategy
          for (s in 1:n_strategies) {
            prob <- sum(optimal_strategies == s) / n_sims
            ceac_data <- rbind(ceac_data, data.frame(
              WTP = wtp,
              Strategy = strategy_names[s],
              Probability = prob
            ))
          }
        }
        
        # Create CEAC plot
        p <- ggplot(ceac_data, aes(x = WTP, y = Probability, color = Strategy)) +
          geom_line(size = 1.2) +
          scale_x_continuous(labels = scales::dollar_format(scale = 0.001, suffix = "K")) +
          scale_y_continuous(labels = scales::percent_format(), limits = c(0, 1)) +
          scale_color_viridis_d(name = "Strategy") +
          labs(
            x = "Willingness-to-Pay Threshold (€)",
            y = "Probability of Being Cost-Effective"
          ) +
          theme_minimal() +
          theme(
            legend.position = "bottom",
            legend.title = element_text(size = 11),
            legend.text = element_text(size = 10),
            panel.grid.minor = element_blank()
          ) +
          guides(color = guide_legend(override.aes = list(size = 2)))
        
        print(p)
        ceac_plot_created <- TRUE
      }
    }
  }, error = function(e) {
    cat("Failed to create manual CEAC:", e$message, "\n")
  })
}

# If all methods fail, display informative message
if (!ceac_plot_created) {
  ggplot() + 
    annotate("text", x = 0.5, y = 0.5, 
             label = "CEAC data not available or failed to process.\nCheck that:\n• PSA analysis completed successfully\n• Cost and effect matrices are available\n• dampack package is properly loaded", 
             size = 12, hjust = 0.5) +
    annotate("text", x = 0.5, y = 0.2,
             label = paste("Available PSA objects:", paste(psa_objects, collapse = ", ")),
             size = 10, hjust = 0.5, color = "darkgray") +
    xlim(0, 1) + ylim(0, 1) +
    theme_void()
}
```

