```{r cea-setup, include=FALSE}
# Set global knitr options
knitr::opts_chunk$set(
  echo = FALSE,
  warning = FALSE,
  message = FALSE,
  fig.align = "center",
  fig.width = 8,
  fig.height = 6,
  dpi = 300,
  out.width = "100%"
)

# Set working directory to project root
knitr::opts_knit$set(root.dir = here::here())

# Load required libraries
if (!require("pacman")) install.packages("pacman")
pacman::p_load(
  here, knitr, kableExtra, ggplot2, dplyr, 
  flextable, officer, scales, gridExtra,
  devtools, readxl, tableone, flexsurv, 
  survival, survminer, gems, mstate, 
  tidyverse, xtable, darthtools, dampack, 
  mvtnorm, Matrix, reshape2
)

# Set ggplot theme
theme_set(theme_minimal() + 
  theme(
    plot.title = element_text(size = 14, face = "bold"),
    plot.subtitle = element_text(size = 12),
    axis.title = element_text(size = 11),
    axis.text = element_text(size = 10),
    legend.title = element_text(size = 11),
    legend.text = element_text(size = 10),
    strip.text = element_text(size = 11, face = "bold")
  ))

# Source helper functions if they exist (silently)
helper_functions <- c(
  "scripts/R/functions/model_fun.R",
  "scripts/R/functions/calculate_outcomes.R",
  "scripts/R/functions/create_tornado_plot.R"
)

for (func_file in helper_functions) {
  if (file.exists(here(func_file))) {
    suppressMessages(suppressWarnings(source(here(func_file))))
  }
}
```

