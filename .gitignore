# Sensitive data folders (but NOT data/output/snapshots/)
data/raw/
data/sensitive/
data/tidy/
data/output/*
!data/output/snapshots/

# Cache files (can be regenerated, manual deletion triggers regeneration)
# ----------------------------------------------------------------------

# Sampling cache files (survival model resampling)
# - sampling_models_n*.rds: Correlated PFS/OS survival curves
# - Location: data/tidy/
# - Regenerate when: survival model formulas change, n_samples changes,
#   USE_BOTH_MODELS setting changes, or clinical data is updated
# - Size: Hundreds of MB
# - Generated by: scripts/R/analysis/06_sampling.R

# PSA cache files (probabilistic sensitivity analysis results)
# - psa_obj.rds: PSA cost/effect results (5000 simulations)
# - psa_params.rds: Sampled parameter values
# - Location: data/tidy/
# - Regenerate when: model structure changes (model_fun.R), base parameters
#   change, sampling cache is regenerated, or parameter distributions change
# - Size: ~660 KB total
# - Generated by: scripts/R/analysis/10_PSA.R

# Note: Since data/tidy/ is ignored above, these cache files are already excluded

# Specific file types
*.xlsx
*.rds
*.dta
*.sav

# EXCEPTION: Allow tracking ONLY the snapshots subfolder within data/output/
# (must come AFTER *.rds ignore to override it)
!data/output/snapshots/
!data/output/snapshots/*.rds

# R-specific ignores
.Rproj.user/
.Rhistory
.RData
.Ruserdata
Rplots.pdf

# Regenerable rendered reports and embedded-resource vignettes
/report_Opus/report.pdf
/report_Opus/report.html
/scripts/QMD/report/*.pdf
/scripts/QMD/technical_docs/*.pdf
/scripts/QMD/vignettes/*.html
# Exception: the bug-fix impact report is tracked as reviewer-facing PR evidence.
!/scripts/QMD/technical_docs/bug_fix_impact.pdf

# Orphaned CommonMark render assets (no tracked Markdown references)
/scripts/QMD/report/CEA_files/
/scripts/QMD/report/EVPPIs_files/
/scripts/QMD/report/OWSA_files/
/scripts/QMD/report/biomarker_decomposition_files/
/scripts/QMD/report/biosimilar_scenario_files/
/scripts/QMD/report/enriched_population_files/
/scripts/QMD/report/para_models_files/
/scripts/QMD/report/scenario_effect_files/

# Windows artifacts
nul

# Claude Code settings (but not CLAUDE.md documentation)
.claude/
.positai

# Adversarial review reports (local working records, not tracked)
/report_Fable5-1/
/report_Opus/
